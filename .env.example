# ===== LLM (required) =====
# openai (default) | anthropic
LLM_PROVIDER=openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_FAST=gpt-5.6-luna
# low keeps reasoning models fast/cheap for extraction work
OPENAI_REASONING_EFFORT=low
# optional: OpenAI-compatible gateway
OPENAI_BASE_URL=
# Anthropic alternative (set LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# ===== Optional data providers =====
# LinkedIn post engagement lane via Apify (free plan includes $5/month credit): https://console.apify.com/account/integrations
APIFY_TOKEN=
# Contact resolution — Apollo (paid plan needed for people search)
APOLLO_API_KEY=
# Contact resolution — Clay webhook table (see README)
CLAY_WEBHOOK_URL=
CLAY_CALLBACK_SECRET=

# ===== Knobs =====
LOOKBACK_DAYS=45
TOP_ACCOUNTS_TO_ENRICH=25
CONTACTS_PER_ACCOUNT=3
# free LinkedIn lane (DuckDuckGo discovery + public post pages); set to 0 to disable
LINKEDIN_FREE_LANE=1
